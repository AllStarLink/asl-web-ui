[Unit]
Description=ASL Web UI
Documentation=man:asl-web-ui(8)
Requires=asl-web-ui.socket
Wants=asl-web-ui-auth.socket
After=network.target

[Service]
Type=simple
User=asterisk
Group=asterisk
ExecStart=/usr/libexec/asl-web-ui/asl-web-ui-server
Restart=on-failure
StateDirectory=asl-web-ui
StateDirectoryMode=0750

# Hardening. /etc/asterisk is writable because the service edits node
# configuration; everything else on the system is read-only to it.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/asterisk
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027
