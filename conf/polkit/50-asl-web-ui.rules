// asl-web-ui runs as the asterisk user. These are the only system actions
// it may take: start, stop or restart the AllStarLink services, reboot or
// power off (the web UI asks for the user's password again first), and the
// commands of its privileged helper (backups, factory reset, Allmon3's
// settings and users, the SA818 radio module, HTTPS and Let's Encrypt in
// Apache, ownership fixes in /etc/asterisk, the network interface list and
// the appliance's fallback access point).
// To restrict them further, add a rule with a lower number in
// /etc/polkit-1/rules.d/ that returns polkit.Result.NO.

polkit.addRule(function(action, subject) {
    if (subject.user != "asterisk") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if ((unit == "asterisk.service" || unit == "allmon3.service" || unit == "asl3-update-nodelist.service") &&
            (verb == "start" || verb == "stop" || verb == "restart")) {
            return polkit.Result.YES;
        }
    }
    if (action.id == "org.freedesktop.login1.reboot" ||
        action.id == "org.freedesktop.login1.reboot-multiple-sessions" ||
        action.id == "org.freedesktop.login1.power-off" ||
        action.id == "org.freedesktop.login1.power-off-multiple-sessions") {
        return polkit.Result.YES;
    }
    if (action.id.indexOf("org.allstarlink.asl-web-ui.") == 0) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
