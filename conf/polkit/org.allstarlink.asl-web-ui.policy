<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Actions of asl-web-ui's privileged helper (asl-web-ui-priv). By default only
  administrators may perform them; 50-asl-web-ui.rules grants them to the
  asterisk user, which the web service runs as.
-->
<policyconfig>
  <vendor>AllStarLink</vendor>
  <vendor_url>https://www.allstarlink.org/</vendor_url>
  <action id="org.allstarlink.asl-web-ui.backup-create">
    <description>Create a backup</description>
    <message>Authentication is required to: create a backup</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.backup-delete">
    <description>Delete a backup</description>
    <message>Authentication is required to: delete a backup</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.backup-read">
    <description>Read a backup</description>
    <message>Authentication is required to: read a backup</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.backup-restore">
    <description>Restore a backup</description>
    <message>Authentication is required to: restore a backup</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.backup-import">
    <description>Add an uploaded or downloaded backup</description>
    <message>Authentication is required to: add an uploaded or downloaded backup</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.backup-read-include-list">
    <description>Read the backup include list</description>
    <message>Authentication is required to: read the backup include list</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.backup-write-include-list">
    <description>Change the backup include list</description>
    <message>Authentication is required to: change the backup include list</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.factory-restore">
    <description>Restore the default AllStarLink configuration</description>
    <message>Authentication is required to: restore the default AllStarLink configuration</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.file-list">
    <description>List Allmon3's and the SA818 module's settings files</description>
    <message>Authentication is required to: list Allmon3's and the SA818 module's settings files</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.file-read">
    <description>Read Allmon3's and the SA818 module's settings files</description>
    <message>Authentication is required to: read Allmon3's and the SA818 module's settings files</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.file-write">
    <description>Change Allmon3's and the SA818 module's settings files</description>
    <message>Authentication is required to: change Allmon3's and the SA818 module's settings files</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.file-delete">
    <description>Remove Allmon3's menu</description>
    <message>Authentication is required to: remove Allmon3's menu</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.allmon3-users">
    <description>List Allmon3's users</description>
    <message>Authentication is required to: list Allmon3's users</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.allmon3-set-password">
    <description>Add an Allmon3 user or change their password</description>
    <message>Authentication is required to: add an Allmon3 user or change their password</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.allmon3-delete-user">
    <description>Remove an Allmon3 user</description>
    <message>Authentication is required to: remove an Allmon3 user</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.sa818-read">
    <description>Read the SA818 radio module settings</description>
    <message>Authentication is required to: read the SA818 radio module settings</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.sa818-apply">
    <description>Program the SA818 radio module</description>
    <message>Authentication is required to: program the SA818 radio module</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.sa818-version">
    <description>Read the SA818 radio module's firmware version</description>
    <message>Authentication is required to: read the SA818 radio module's firmware version</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.https-status">
    <description>Read the web server's HTTPS settings</description>
    <message>Authentication is required to: read the web server's HTTPS settings</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.https-install">
    <description>Install certbot for Let's Encrypt certificates</description>
    <message>Authentication is required to: install certbot for Let's Encrypt certificates</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.https-enable-listener">
    <description>Enable HTTPS on port 443 in Apache</description>
    <message>Authentication is required to: enable HTTPS on port 443 in Apache</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.https-obtain">
    <description>Get a Let's Encrypt certificate and use it in Apache</description>
    <message>Authentication is required to: get a Let's Encrypt certificate and use it in Apache</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.https-redirect">
    <description>Change the HTTP to HTTPS redirection</description>
    <message>Authentication is required to: change the HTTP to HTTPS redirection</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.https-cockpit">
    <description>Use the Let's Encrypt certificate in Cockpit</description>
    <message>Authentication is required to: use the Let's Encrypt certificate in Cockpit</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.https-renew-test">
    <description>Test the renewal of the Let's Encrypt certificate</description>
    <message>Authentication is required to: test the renewal of the Let's Encrypt certificate</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.https-remove">
    <description>Stop using the Let's Encrypt certificate in Apache</description>
    <message>Authentication is required to: stop using the Let's Encrypt certificate in Apache</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.asterisk-fix-ownership">
    <description>Give a configuration file back to the asterisk user</description>
    <message>Authentication is required to: give a configuration file back to the asterisk user</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.network-status">
    <description>List the network interfaces and the fallback access point's state</description>
    <message>Authentication is required to: list the network interfaces and the fallback access point's state</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.network-fallback-ap">
    <description>Enable or disable the fallback access point</description>
    <message>Authentication is required to: enable or disable the fallback access point</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.net44-status">
    <description>Show the 44Net Connect tunnel and its firewall zone</description>
    <message>Authentication is required to: show the 44Net Connect tunnel and its firewall zone</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.net44-zone">
    <description>Set up the 44Net Connect firewall zone</description>
    <message>Authentication is required to: set up the 44Net Connect firewall zone</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.net44-configure">
    <description>Set up the 44Net Connect tunnel</description>
    <message>Authentication is required to: set up the 44Net Connect tunnel</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.net44-migrate">
    <description>Move a hand-made 44Net Connect tunnel to NetworkManager</description>
    <message>Authentication is required to: move a hand-made 44Net Connect tunnel to NetworkManager</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.net44-mode">
    <description>Choose full tunnel or split routing for 44Net Connect</description>
    <message>Authentication is required to: choose full tunnel or split routing for 44Net Connect</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.net44-start">
    <description>Start the 44Net Connect tunnel</description>
    <message>Authentication is required to: start the 44Net Connect tunnel</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.net44-confirm">
    <description>Keep the 44Net Connect tunnel running</description>
    <message>Authentication is required to: keep the 44Net Connect tunnel running</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.net44-stop">
    <description>Stop the 44Net Connect tunnel</description>
    <message>Authentication is required to: stop the 44Net Connect tunnel</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.net44-remove">
    <description>Remove the 44Net Connect tunnel</description>
    <message>Authentication is required to: remove the 44Net Connect tunnel</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.dahdi-remove">
    <description>Uninstall the DAHDI kernel modules (dahdi-dkms)</description>
    <message>Authentication is required to: uninstall the DAHDI kernel modules (dahdi-dkms)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.allstarlink.asl-web-ui.apt-update">
    <description>Refresh the package lists (apt-get update)</description>
    <message>Authentication is required to: refresh the package lists (apt-get update)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
