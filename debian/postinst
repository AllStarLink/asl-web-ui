#!/bin/sh
# postinst script for asl-web-ui

set -e

if [ -e /usr/share/apache2/apache2-maintscript-helper ]; then
	. /usr/share/apache2/apache2-maintscript-helper
fi

# The web UI refuses logins over plain HTTP, so without HTTPS it cannot be
# used at all (not even to set HTTPS up). If nothing serves port 443, enable
# Debian's default-ssl site with the self-signed certificate. apache2_invoke
# leaves alone a module or site the admin disabled. Not when another package
# (the ASL3 appliance) owns Apache's sites: it provides port 443 itself.
enable_https() {
	[ "$(/usr/libexec/asl-web-ui/asl-web-ui-https-sync --mode)" = own ] || return 0
	command -v ss >/dev/null || return 0
	[ -z "$(ss -Hltn 'sport = :443' 2>/dev/null)" ] || return 0
	! apache2ctl -S 2>/dev/null | grep -Eq '^\*?[^[:space:]]*:443[[:space:]]' || return 0
	[ -e /etc/apache2/sites-available/default-ssl.conf ] || return 0
	if [ ! -e /etc/ssl/certs/ssl-cert-snakeoil.pem ] && command -v make-ssl-cert >/dev/null; then
		make-ssl-cert generate-default-snakeoil || return 0
	fi
	[ -e /etc/ssl/certs/ssl-cert-snakeoil.pem ] || return 0
	apache2_invoke enmod ssl || exit $?
	apache2_invoke ensite default-ssl || exit $?
	a2query -m ssl >/dev/null 2>&1 && a2query -s default-ssl >/dev/null 2>&1 || return 0
	cat <<'EOF'

asl-web-ui: enabled HTTPS in Apache (port 443) with a self-signed
certificate. Browsers will warn about it; the HTTPS page in asl-web-ui
can get a Let's Encrypt certificate instead.

EOF
}

do_configure() {
	# Only members of this group may log in to the web UI.
	if ! getent group asl-web-ui >/dev/null; then
		addgroup --system --quiet asl-web-ui
	fi

	if [ -e /usr/share/apache2/apache2-maintscript-helper ]; then
		apache2_invoke enmod proxy || exit $?
		apache2_invoke enmod proxy_http || exit $?
		apache2_invoke enmod headers || exit $?
		apache2_invoke enconf asl-web-ui || exit $?
		# Put a Let's Encrypt certificate where the apache_vhosts setting
		# wants it (asl-web-ui's own site, or the snippet another package's
		# site includes).
		/usr/libexec/asl-web-ui/asl-web-ui-https-sync ||
			echo "asl-web-ui: could not update the HTTPS configuration; see the HTTPS page." >&2
		enable_https
	fi

	# nginx cannot enable snippets automatically: the admin includes our file in a site.
	if [ -d /etc/nginx ] && ! grep -rqs 'include /etc/asl-web-ui/nginx.conf' /etc/nginx/; then
		cat <<'EOF'

asl-web-ui: to serve it with nginx, add this line inside the server { }
block of your site (preferably the HTTPS one), then reload nginx:

    include /etc/asl-web-ui/nginx.conf;

EOF
	fi

	if [ -z "$(getent group asl-web-ui | cut -d: -f4)" ]; then
		cat <<'EOF'

asl-web-ui: no users can log in yet. Add each user who should manage
this node to the asl-web-ui group, for example:

    sudo usermod -aG asl-web-ui <username>

Then open https://<this-server>/asl-web-ui/

EOF
	fi
}

case "$1" in
	configure)
		do_configure
		;;
	abort-upgrade|abort-remove|abort-deconfigure)
		;;
	*)
		echo "postinst called with unknown argument \`$1'" >&2
		exit 1
		;;
esac

#DEBHELPER#

exit 0
